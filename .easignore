# ---------------------------------------------------------------------------
# Negations — must stay last to override the rules above
# ---------------------------------------------------------------------------

# Required by app.json `android.googleServicesFile`. It is listed in .gitignore,
# so without this line the Android build would come up without Firebase config
# and push notifications would break.
!google-services.json
